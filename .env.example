# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: (Frontend / Vercel) URL of your Render backend API (e.g. https://your-backend.onrender.com).
# Leave empty when running unified full-stack on the same domain.
VITE_API_URL=""

# MONGODB_URI: (Backend / Render) MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=""

# PORT: Server port (defaults to 3000 locally, 10000 on Render).
PORT="3000"
